/*
  BABY UNIT, BLE CLIENT (AI)   ESP32 NodeMCU-32S, arduino-esp32 core 3.3.x
  AI build of the supplied v5 baby sketch. Same hardware, same BLE route, same
  room-side message contract ("OK", "FALL", "CRY") plus one addition:
  "WANDER" when the baby sits at the edge of the Bluetooth range.

  Board: "ESP32 Dev Module". Serial Monitor: 115200.
  Wiring (unchanged): MPU6050 VCC->3V3, GND->GND, SDA->21, SCL->22. Sound sensor: VCC->3V3, GND, AO->GPIO34.

  WHAT THE AI ADDS (all inference runs ON the ESP32; nothing leaves the nursery):
  1. Cry classifier (sound sensor): 8 short ADC bursts at 2 kHz over 1.6 s ->
     9 features (band shares around the 300-500 Hz cry fundamental, envelope
     modulation/depth, zero-crossing rate, duty) -> softmax model -> cry
     probability. "CRY" is only sent while the MODEL believes it is a baby,
     not a knock, TV hiss, fan hum, or a steady appliance tone.
  2. Motion classifier (MPU6050 accel + GYRO, the gyro v5 never read): a 2 s,
     50 Hz window -> 11 features (free-fall fraction, impact, jerk, gyro
     energy, post-impact stillness, tilt change, rhythm) -> 3-class model
     {normal, active, fall}. When the v5 temporal detector triggers, the model
     decides: confirmed fall -> FALL; clearly play/running (doura douri) ->
     vetoed; uncertain -> the proven impact-then-stillness gate decides, so a
     model misfire can never silence a real fall pattern.
  3. Bluetooth range: the ESP32 is the BLE central, so it polls the link RSSI,
     smooths it (EMA + hysteresis), classifies near/edge/far/lost, and after
     8 s sustained "far" sends WANDER every 2 s - a warning BEFORE the link,
     and the receiver's 6 s link-loss alarm, drops. The AI room receiver
     (uno_room_receiver_ai) prints a wander alert; the supplied receiver
     prints "unknown msg: WANDER" and otherwise works unchanged.
  4. Sensor fusion: one alert state with priorities
     FALL > SENSOR_FAULT > WANDER > CRY > activity > OK, plus on-going
     activity recognition (is the baby sleeping or up and running) printed on
     USB. The fusion rules are mirrored in server/ai/fusion.py and unit-tested
     there.

  MODELS: weights live in ai_weights.h, generated by `python -m server.ai.train`
  from the simulator in server/ai/simulate.py. The feature math below is a
  line-for-line port of server/ai/features.py - change one side and the tests
  in server/test_ai.py will fail. Retrain with real nursery captures when you
  have them; simulator weights are a starting point, not a medical device.

  All v5 robustness behavior is kept: candidates survive MPU faults, bus reset
  before slow re-init, 100 kHz I2C, sensor-loss fallback still sends FALL.

  Not compiled by the author against the real core (logic checked in host
  simulation only). Paste any compiler error back.
*/
#include <Wire.h>
#include <BLEDevice.h>
#include <math.h>
#include "ai_weights.h"

// ===== SETTINGS =====
const char *TARGET_ADDR = "4d:42:62:50:10:0f";   // module address seen in nRF Connect
const char *TARGET_NAME = "HC-05";               // fallback match by advertised name
static BLEUUID SERVICE_UUID((uint16_t)0xFFE0);
static BLEUUID CHAR_UUID((uint16_t)0xFFE1);      // NOTIFY + WRITE. FFE2 is never touched.
const int BTN_DEMO = 0;                          // BOOT button
const int SOUND_PIN = 34;                        // sound sensor AO (ADC1 pin)
const int CRY_SWING = 400;                       // loudness gate before the AI runs (ADC counts, 50 ms window)
const unsigned long CRY_MIN_MS = 1500, CRY_QUIET_MS = 1000, SOUND_WINDOW_MS = 50, CRY_SEND_MS = 1000;

const float IMPACT_G = 1.8, FREEFALL_G = 0.5, STILL_SWING = 0.35, STILL_DEV = 0.3;
const int FREEFALL_N = 2;
const unsigned long IGNORE_MS = 600, WATCH_END_MS = 1800, RESTART_LIMIT_MS = 3000;
const unsigned long COOLDOWN_MS = 5000, HEARTBEAT_MS = 1000, RETRY_MS = 3000;
const unsigned long I2C_HZ = 100000;
const unsigned long CANDIDATE_MAX_MS = 5500;
const bool ALERT_ON_SENSOR_LOSS = true;

// ===== AI settings (mirror server/ai: change both sides together) =====
const float AI_FALL_PROB = 0.55, AI_ACTIVE_VETO = 0.60, AI_CRY_PROB = 0.65;
const int MOTION_N = 100;                        // 2 s at 50 Hz
const unsigned long MOTION_SAMPLE_MS = 20;
const int AUDIO_BURSTS = 8, AUDIO_N = 128;       // 8 x 128 samples at 2 kHz, 1.6 s total
const unsigned long AUDIO_BURST_MS = 200, AUDIO_US = 500;
const float ADC_CENTER = 2048.0, ADC_FULL = 4095.0;
const float AUDIO_EPS = 1e-9;
const unsigned long RSSI_POLL_MS = 500;
const float RSSI_ALPHA = 0.181;                  // EMA tau 2.5 s at a 0.5 s poll
const float RSSI_NEAR = -58.0, RSSI_FAR = -70.0, RSSI_HYST = 3.0;
const unsigned long WANDER_AFTER_MS = 8000, WANDER_SEND_MS = 2000;

// ===== BLE state =====
BLEClient *client = nullptr;
BLERemoteCharacteristic *rc = nullptr;
BLEAdvertisedDevice *target = nullptr;
volatile bool connected = false, foundTarget = false, lineReady = false;
volatile uint32_t rxBytes = 0;
char rxBuf[24], lastLine[24];
byte rxLen = 0;
int failCount = 0;

// ===== motion state =====
int mpuAddr = 0, freefallCount = 0;
float accelLSB = 16384.0, gyroLSB = 65.5;
bool watching = false, windowStarted = false, lastDemo = HIGH;
bool faultSinceTrigger = false;
int i2cFaults = 0;
float aMin = 0, aMax = 0, peakG = 0, lastA = 1.0;
unsigned long watchStart = 0, trigStart = 0, cooldownUntil = 0, lastSample = 0, lastBeat = 0;
int zeroCount = 0;
unsigned long lastMpuCheck = 0, lastRecover = 0;
unsigned long lastMpuTry = 0, lastStatus = 0, lastAttempt = 0, lastMotionTick = 0, lastClassify = 0;

// motion ring buffers (oldest..newest via ringAt); svm/gmag are derived at insert
float ringAx[MOTION_N], ringAy[MOTION_N], ringAz[MOTION_N], ringSvm[MOTION_N], ringGmag[MOTION_N];
int ringPos = 0, ringFill = 0;
float lastMotionProbs[3] = {1, 0, 0};
int lastMotionClass = 0;

// ===== cry state =====
int sMin = 4095, sMax = 0, lastSwing = 0;
unsigned long winStart = 0, loudStart = 0, lastLoud = 0, quietSince = 0, lastCrySend = 0, lastBurst = 0, lastCryEval = 0;
bool cryActive = false;
float burstRms[AUDIO_BURSTS], burstP2p[AUDIO_BURSTS], burstZcr[AUDIO_BURSTS];
float burstSub[AUDIO_BURSTS], burstLow[AUDIO_BURSTS], burstMid[AUDIO_BURSTS];
int burstPos = 0, burstCount = 0;
float cryProb = 0;

// ===== range state =====
float rssiEma = 0; bool rssiInit = false;
int rangeZone = 3;                               // 0 near, 1 edge, 2 far, 3 lost
unsigned long farSince = 0, lastRssiPoll = 0, lastWanderSend = 0;
bool wandering = false;

// ----- notifications from the module (ACK) -----
static void onNotify(BLERemoteCharacteristic *c, uint8_t *data, size_t len, bool isNotify) {
  for (size_t i = 0; i < len; i++) {
    char ch = (char)data[i];
    rxBytes++;
    if (ch == '\n') {
      rxBuf[rxLen] = 0;
      if (rxLen > 0) { strncpy(lastLine, rxBuf, sizeof(lastLine) - 1); lastLine[sizeof(lastLine) - 1] = 0; lineReady = true; }
      rxLen = 0;
    } else if (ch != '\r' && rxLen < sizeof(rxBuf) - 1) rxBuf[rxLen++] = ch;
  }
}

class ClientCB : public BLEClientCallbacks {
  void onConnect(BLEClient *c) {}
  void onDisconnect(BLEClient *c) { connected = false; rc = nullptr; }
};
static ClientCB clientCB;

class ScanCB : public BLEAdvertisedDeviceCallbacks {
  void onResult(BLEAdvertisedDevice dev) {
    char name[32] = "", addr[20] = "";
    if (dev.haveName()) { strncpy(name, dev.getName().c_str(), sizeof(name) - 1); name[sizeof(name) - 1] = 0; }
    strncpy(addr, dev.getAddress().toString().c_str(), sizeof(addr) - 1); addr[sizeof(addr) - 1] = 0;
    Serial.printf("  seen: %s  name='%s'  rssi=%d\n", addr, name, (int)dev.getRSSI());
    if (strcasecmp(addr, TARGET_ADDR) == 0 || strcmp(name, TARGET_NAME) == 0) {
      if (target) delete target;
      target = new BLEAdvertisedDevice(dev);
      foundTarget = true;
      BLEDevice::getScan()->stop();
    }
  }
};
static ScanCB scanCB;

bool scanForTarget() {
  foundTarget = false;
  BLEScan *scan = BLEDevice::getScan();
  scan->setAdvertisedDeviceCallbacks(&scanCB);
  scan->setActiveScan(true);
  scan->setInterval(100);
  scan->setWindow(99);
  scan->start(6, false);
  scan->clearResults();
  return foundTarget;
}

bool connectToTarget() {
  client = BLEDevice::createClient();
  client->setClientCallbacks(&clientCB);
  Serial.println("[BLE] connecting...");
  if (!client->connect(target)) { Serial.println("[BLE][FAIL] connect() returned false"); return false; }
  connected = true;
  BLERemoteService *svc = client->getService(SERVICE_UUID);
  if (!svc) { Serial.println("[BLE][FAIL] service FFE0 not found"); client->disconnect(); return false; }
  BLERemoteCharacteristic *c = svc->getCharacteristic(CHAR_UUID);
  if (!c) { Serial.println("[BLE][FAIL] characteristic FFE1 not found"); client->disconnect(); return false; }
  Serial.printf("[BLE] FFE1 found: canWrite=%d canNotify=%d\n", (int)c->canWrite(), (int)c->canNotify());
  if (!c->canWrite()) { Serial.println("[BLE][FAIL] FFE1 not writable"); client->disconnect(); return false; }
  if (c->canNotify()) c->registerForNotify(onNotify);
  rc = c;
  rssiInit = false; rangeZone = 3; wandering = false; farSince = 0;
  Serial.println("[BLE] READY: FFE1 write + notify");
  return true;
}

void tryLink() {
  Serial.println("[BLE] scanning for the module (phone/nRF must NOT be connected to it)...");
  bool ok = false;
  if (!scanForTarget()) Serial.println("[BLE][FAIL] module not found in scan");
  else ok = connectToTarget();
  if (ok) failCount = 0;
  else if (++failCount >= 10) { Serial.println("[BLE] 10 failures -> restarting ESP32"); delay(300); ESP.restart(); }
}

bool sendLine(const char *s) {
  BLERemoteCharacteristic *r = rc;
  if (!connected || !r) return false;
  r->writeValue((uint8_t *)s, strlen(s), true);
  return true;
}

// ----- MPU6050 (accel + gyro) -----
bool mpuRegRead(int addr, uint8_t reg, uint8_t &val) {
  Wire.beginTransmission(addr); Wire.write(reg);
  if (Wire.endTransmission(false) != 0) return false;
  if (Wire.requestFrom(addr, 1) != 1) return false;
  val = (uint8_t)Wire.read();
  return true;
}

bool initMPU() {
  for (int a = 0x68; a <= 0x69; a++) {
    Wire.beginTransmission(a);
    if (Wire.endTransmission() != 0) continue;
    Wire.beginTransmission(a); Wire.write(0x6B); Wire.write(0x00);       // wake up
    if (Wire.endTransmission() != 0) continue;
    delay(50);
    uint8_t cfg = 0xFF;
    for (int tries = 0; tries < 3; tries++) {                            // +-8 g, retry until it reads back
      Wire.beginTransmission(a); Wire.write(0x1C); Wire.write(0x10);
      Wire.endTransmission();
      delay(20);
      if (mpuRegRead(a, 0x1C, cfg) && cfg == 0x10) break;
    }
    if (cfg > 0x18) cfg = 0x00;
    accelLSB = 16384.0 / (float)(1 << ((cfg >> 3) & 3));
    uint8_t gcfg = 0xFF;
    for (int tries = 0; tries < 3; tries++) {                            // +-500 deg/s gyro
      Wire.beginTransmission(a); Wire.write(0x1B); Wire.write(0x08);
      Wire.endTransmission();
      delay(20);
      if (mpuRegRead(a, 0x1B, gcfg) && gcfg == 0x08) break;
    }
    if (gcfg > 0x18) gcfg = 0x00;
    gyroLSB = 131.0 / (float)(1 << ((gcfg >> 3) & 3));                   // 0->131, 1->65.5, 2->32.8, 3->16.4
    mpuAddr = a; delay(100);
    Serial.printf("[OK] MPU6050 at 0x%02X, ACCEL_CONFIG=0x%02X GYRO_CONFIG=0x%02X, scale=%.0f LSB/g, %.1f LSB/(deg/s)\n",
                  a, cfg, gcfg, accelLSB, gyroLSB);
    return true;
  }
  mpuAddr = 0;
  return false;
}

// one 14-byte burst read: accel xyz, temp, gyro xyz. allZero = chip reset/loose wire, never feed it to the AI.
bool readMotion(float &g, float &gm, bool &allZero) {
  Wire.beginTransmission(mpuAddr); Wire.write(0x3B);
  if (Wire.endTransmission(false) != 0 || Wire.requestFrom(mpuAddr, 14) != 14) return false;
  int16_t v[7];
  for (int i = 0; i < 7; i++) { int hi = Wire.read(); int lo = Wire.read(); v[i] = (hi << 8) | lo; }
  allZero = (v[0] == 0 && v[1] == 0 && v[2] == 0 && v[4] == 0 && v[5] == 0 && v[6] == 0);
  float x = v[0] / accelLSB, y = v[1] / accelLSB, z = v[2] / accelLSB;
  float gx = v[4] / gyroLSB, gy = v[5] / gyroLSB, gz = v[6] / gyroLSB;
  g = sqrt(x * x + y * y + z * z);
  gm = sqrt(gx * gx + gy * gy + gz * gz);
  ringAx[ringPos] = x; ringAy[ringPos] = y; ringAz[ringPos] = z;
  ringSvm[ringPos] = g; ringGmag[ringPos] = gm;
  ringPos = (ringPos + 1) % MOTION_N;
  if (ringFill < MOTION_N) ringFill++;
  return true;
}

void busReset() { Wire.end(); delay(2); Wire.begin(21, 22); Wire.setClock(I2C_HZ); }

void recoverMPU(const char *why) {
  unsigned long now = millis();
  lastRecover = now; i2cFaults++;
  Serial.printf("[MPU FAULT #%d] %s | pending=%d last|a|=%.2f g peak=%.2f g ms-since-trigger=%lu\n",
                i2cFaults, why, (int)watching, lastA, peakG, watching ? (now - trigStart) : 0UL);
  if (watching) { faultSinceTrigger = true; watchStart = now; windowStarted = false; }
  zeroCount = 0; freefallCount = 0;
  busReset();
  bool chipOk = false;
  if (mpuAddr) {
    uint8_t pm = 0xFF, cfg = 0xFF, gcfg = 0xFF;
    chipOk = mpuRegRead(mpuAddr, 0x6B, pm) && mpuRegRead(mpuAddr, 0x1C, cfg) && mpuRegRead(mpuAddr, 0x1B, gcfg)
             && !(pm & 0x40) && cfg == 0x10 && gcfg == 0x08;
  }
  if (chipOk) Serial.println("[MPU] bus reset was enough (chip still configured) - no slow re-init");
  else { mpuAddr = 0; initMPU(); }
  lastMpuCheck = millis();
}

// ----- AI inference (line-for-line port of server/ai) -----
float ringAt(const float *ring, int i) {  // logical 0 = oldest
  int start = (ringFill < MOTION_N) ? 0 : ringPos;
  return ring[(start + i) % MOTION_N];
}

void aiSoftmax(const float *feat, int nf, int nc, const float *mean, const float *scale,
               const float *w, const float *b, float *probs) {
  float top = -1e30;
  for (int c = 0; c < nc; c++) {
    float total = b[c];
    for (int f = 0; f < nf; f++) total += w[c * nf + f] * ((feat[f] - mean[f]) / scale[f]);
    probs[c] = total;
    if (total > top) top = total;
  }
  float norm = 0;
  for (int c = 0; c < nc; c++) { probs[c] = expf(probs[c] - top); norm += probs[c]; }
  for (int c = 0; c < nc; c++) probs[c] /= norm;
}

int motionFeatures(float *feat) {
  if (ringFill < MOTION_N) return 0;
  float svm[MOTION_N], gmag[MOTION_N];
  float svmSum = 0, svmMax = 0, svmMin = 99, gSum = 0, gMax = 0;
  int freefall = 0;
  for (int i = 0; i < MOTION_N; i++) {
    svm[i] = ringAt(ringSvm, i); gmag[i] = ringAt(ringGmag, i);
    svmSum += svm[i]; gSum += gmag[i];
    if (svm[i] > svmMax) svmMax = svm[i];
    if (svm[i] < svmMin) svmMin = svm[i];
    if (gmag[i] > gMax) gMax = gmag[i];
    if (svm[i] < FREEFALL_G) freefall++;
  }
  float svmMean = svmSum / MOTION_N, gMean = gSum / MOTION_N;
  float var = 0, jerkSq = 0, postVar = 0, postMean = 0;
  for (int i = 0; i < MOTION_N; i++) { float d = svm[i] - svmMean; var += d * d; }
  for (int i = 1; i < MOTION_N; i++) { float j = (svm[i] - svm[i - 1]) * 50.0; jerkSq += j * j; }
  for (int i = MOTION_N - 20; i < MOTION_N; i++) postMean += svm[i];
  postMean /= 20.0;
  for (int i = MOTION_N - 20; i < MOTION_N; i++) { float d = svm[i] - postMean; postVar += d * d; }
  float fm[3] = {0, 0, 0}, lm[3] = {0, 0, 0};
  for (int i = 0; i < 25; i++) {
    fm[0] += ringAt(ringAx, i); fm[1] += ringAt(ringAy, i); fm[2] += ringAt(ringAz, i);
    lm[0] += ringAt(ringAx, MOTION_N - 25 + i); lm[1] += ringAt(ringAy, MOTION_N - 25 + i); lm[2] += ringAt(ringAz, MOTION_N - 25 + i);
  }
  for (int a = 0; a < 3; a++) { fm[a] /= 25.0; lm[a] /= 25.0; }
  float dot = fm[0] * lm[0] + fm[1] * lm[1] + fm[2] * lm[2];
  float norm = sqrt(fm[0] * fm[0] + fm[1] * fm[1] + fm[2] * fm[2]) * sqrt(lm[0] * lm[0] + lm[1] * lm[1] + lm[2] * lm[2]);
  float cosv = dot / (norm + 1e-9); if (cosv > 1) cosv = 1; if (cosv < -1) cosv = -1;
  float tiltDeg = degrees(acosf(cosv));
  int crossings = 0;
  for (int i = 1; i < MOTION_N; i++) if ((svm[i] - svmMean) * (svm[i - 1] - svmMean) < 0) crossings++;
  feat[0] = svmMean; feat[1] = sqrt(var / MOTION_N); feat[2] = svmMax; feat[3] = svmMin;
  feat[4] = (float)freefall / MOTION_N; feat[5] = sqrt(jerkSq / (MOTION_N - 1));
  feat[6] = gMean; feat[7] = gMax; feat[8] = sqrt(postVar / 20.0); feat[9] = tiltDeg;
  feat[10] = (float)crossings / (MOTION_N - 1);
  return 1;
}

int classifyMotion(float *probs) {
  float feat[AI_MOTION_N_FEATURES];
  if (!motionFeatures(feat)) { probs[0] = 1; probs[1] = 0; probs[2] = 0; return 0; }
  aiSoftmax(feat, AI_MOTION_N_FEATURES, AI_MOTION_N_CLASSES,
            AI_MOTION_MEAN, AI_MOTION_SCALE, &AI_MOTION_W[0][0], AI_MOTION_B, probs);
  int best = 0;
  for (int c = 1; c < AI_MOTION_N_CLASSES; c++) if (probs[c] > probs[best]) best = c;
  return best;
}

float goertzelPower(const float *x, int n, int k) {
  float w = 2.0f * PI * k / n;
  float coeff = 2.0f * cosf(w);
  float s0 = 0, s1 = 0, s2 = 0;
  for (int i = 0; i < n; i++) { s0 = x[i] + coeff * s1 - s2; s2 = s1; s1 = s0; }
  float power = s1 * s1 + s2 * s2 - coeff * s1 * s2;
  float half = n / 2.0f;
  return power / (half * half);
}

void captureBurst() {  // 128 samples at 2 kHz (~64 ms). Only called while loud, and never while a fall candidate is pending.
  float x[AUDIO_N];
  unsigned long t0 = micros();
  int rawMin = 4095, rawMax = 0;
  for (int i = 0; i < AUDIO_N; i++) {
    while (micros() - t0 < (unsigned long)i * AUDIO_US) { }
    int raw = analogRead(SOUND_PIN);
    if (raw < rawMin) rawMin = raw;
    if (raw > rawMax) rawMax = raw;
    x[i] = raw - ADC_CENTER;
  }
  float sq = 0;
  for (int i = 0; i < AUDIO_N; i++) sq += x[i] * x[i];
  float rms = sqrt(sq / AUDIO_N);
  int crossings = 0;
  for (int i = 1; i < AUDIO_N; i++) if (x[i] * x[i - 1] < 0) crossings++;
  float sub = 0, low = 0, mid = 0;
  for (int k = 5; k <= 16; k++) sub += goertzelPower(x, AUDIO_N, k);
  for (int k = 17; k <= 34; k++) low += goertzelPower(x, AUDIO_N, k);
  for (int k = 35; k <= 63; k++) mid += goertzelPower(x, AUDIO_N, k);
  float total = 2.0f * rms * rms + AUDIO_EPS;
  burstRms[burstPos] = rms; burstP2p[burstPos] = rawMax - rawMin;
  burstZcr[burstPos] = (float)crossings / (AUDIO_N - 1);
  burstSub[burstPos] = sub / total; burstLow[burstPos] = low / total; burstMid[burstPos] = mid / total;
  burstPos = (burstPos + 1) % AUDIO_BURSTS;
  if (burstCount < AUDIO_BURSTS) burstCount++;
}

float classifyCry() {  // returns cry probability; needs a full 1.6 s observation
  if (burstCount < AUDIO_BURSTS) return 0;
  float rms[AUDIO_BURSTS];
  int start = (burstCount < AUDIO_BURSTS) ? 0 : burstPos;
  float sum = 0, rmsMax = 0, p2pMax = 0, zcrSum = 0, subSum = 0, lowSum = 0, midSum = 0;
  for (int i = 0; i < AUDIO_BURSTS; i++) {
    rms[i] = burstRms[(start + i) % AUDIO_BURSTS];
    sum += rms[i];
    if (rms[i] > rmsMax) rmsMax = rms[i];
    if (burstP2p[(start + i) % AUDIO_BURSTS] > p2pMax) p2pMax = burstP2p[(start + i) % AUDIO_BURSTS];
    zcrSum += burstZcr[(start + i) % AUDIO_BURSTS];
    subSum += burstSub[(start + i) % AUDIO_BURSTS];
    lowSum += burstLow[(start + i) % AUDIO_BURSTS];
    midSum += burstMid[(start + i) % AUDIO_BURSTS];
  }
  float mean = sum / AUDIO_BURSTS;
  float var = 0; int dutyN = 0; float rmsMin = rms[0];
  for (int i = 0; i < AUDIO_BURSTS; i++) {
    float d = rms[i] - mean; var += d * d;
    if (rms[i] > 0.5f * rmsMax) dutyN++;
    if (rms[i] < rmsMin) rmsMin = rms[i];
  }
  float feat[AI_CRY_N_FEATURES];
  feat[0] = mean; feat[1] = p2pMax / ADC_FULL; feat[2] = zcrSum / AUDIO_BURSTS;
  feat[3] = subSum / AUDIO_BURSTS; feat[4] = lowSum / AUDIO_BURSTS; feat[5] = midSum / AUDIO_BURSTS;
  feat[6] = sqrt(var / AUDIO_BURSTS) / (mean + AUDIO_EPS);
  feat[7] = (rmsMax - rmsMin) / (rmsMax + AUDIO_EPS);
  feat[8] = (float)dutyN / AUDIO_BURSTS;
  float probs[AI_CRY_N_CLASSES];
  aiSoftmax(feat, AI_CRY_N_FEATURES, AI_CRY_N_CLASSES,
            AI_CRY_MEAN, AI_CRY_SCALE, &AI_CRY_W[0][0], AI_CRY_B, probs);
  return probs[1];
}

// ----- range estimation -----
const char *zoneName(int z) { return z == 0 ? "near" : z == 1 ? "edge" : z == 2 ? "FAR" : "lost"; }

void pollRange(unsigned long now, bool linked) {
  if (!linked || now - lastRssiPoll < RSSI_POLL_MS) {
    if (!linked) { rangeZone = 3; wandering = false; farSince = 0; rssiInit = false; }
    return;
  }
  lastRssiPoll = now;
  int raw = client ? client->getRssi() : 0;
  if (raw == 0 || raw < -110 || raw > -20) return;   // implausible read: keep the last EMA
  if (!rssiInit) { rssiEma = raw; rssiInit = true; }
  else rssiEma += RSSI_ALPHA * (raw - rssiEma);
  int prev = rangeZone;
  if (rangeZone == 3) rangeZone = rssiEma >= RSSI_NEAR ? 0 : (rssiEma >= RSSI_FAR ? 1 : 2);
  else if (rangeZone == 0 && rssiEma < RSSI_NEAR - RSSI_HYST) rangeZone = rssiEma >= RSSI_FAR ? 1 : 2;
  else if (rangeZone == 1 && !(rssiEma > RSSI_FAR - RSSI_HYST && rssiEma < RSSI_NEAR + RSSI_HYST)) rangeZone = rssiEma >= RSSI_NEAR ? 0 : (rssiEma >= RSSI_FAR ? 1 : 2);
  else if (rangeZone == 2 && rssiEma > RSSI_FAR + RSSI_HYST) rangeZone = rssiEma >= RSSI_NEAR ? 0 : 1;
  if (rangeZone == 2) {
    if (prev != 2) farSince = now;
    if (!wandering && now - farSince >= WANDER_AFTER_MS) {
      wandering = true;
      Serial.printf("[WANDER] baby at Bluetooth range limit (rssi=%.0f dBm)\n", rssiEma);
    }
  } else if (wandering) { wandering = false; Serial.println("[WANDER] cleared"); }
  if (wandering && now - lastWanderSend >= WANDER_SEND_MS) { lastWanderSend = now; sendLine("WANDER\n"); }
}

// ----- fall / cry event paths -----
void sendFall(const char *why) {
  Serial.printf(">>> FALL (%s) -> sending to room unit\n", why);
  sendLine("FALL\n");
  cooldownUntil = millis() + COOLDOWN_MS;
}

// AI gate at the stillness check: confirmed -> FALL, play/running -> veto, uncertain -> v5 gate decides.
void evaluateCandidate(unsigned long now, bool stillOk) {
  float probs[3];
  classifyMotion(probs);
  Serial.printf("[AI motion] p(normal)=%.2f p(active)=%.2f p(fall)=%.2f | stillness gate: %s\n",
                probs[0], probs[1], probs[2], stillOk ? "still" : "moving");
  if (probs[2] >= AI_FALL_PROB) sendFall("AI confirmed fall");
  else if (probs[1] >= AI_ACTIVE_VETO) {
    Serial.println("[AI veto] motion looks like play/running, not a fall -> no alert");
    cooldownUntil = now + 1000;
  } else if (stillOk) sendFall(faultSinceTrigger ? "impact + stillness (after MPU fault)" : "impact + stillness");
  else { Serial.println("not still enough -> ignored"); cooldownUntil = now + 1000; }
}

void fallLogic(float a, unsigned long now) {
  if (a > peakG) peakG = a;
  if (now < cooldownUntil) return;
  if (!watching) {
    bool trig = false; const char *why = "";
    if (a > IMPACT_G) { trig = true; why = "impact"; }
    else if (a < FREEFALL_G) { if (++freefallCount >= FREEFALL_N) { trig = true; why = "free-fall"; } }
    else freefallCount = 0;
    if (trig) {
      watching = true; windowStarted = false; watchStart = now; trigStart = now; freefallCount = 0; faultSinceTrigger = false;
      Serial.printf("trigger: %s (a=%.2f g) -> waiting for stillness + AI classification...\n", why, a);
    }
    return;
  }
  if (a > IMPACT_G && now - trigStart < RESTART_LIMIT_MS) { watchStart = now; windowStarted = false; return; }
  unsigned long t = now - watchStart;
  if (t < IGNORE_MS) return;
  if (!windowStarted) { windowStarted = true; aMin = aMax = a; }
  if (a < aMin) aMin = a;
  if (a > aMax) aMax = a;
  if (t >= WATCH_END_MS) {
    watching = false;
    float swing = aMax - aMin, dev = fabs(a - 1.0);
    bool stillOk = swing < STILL_SWING && dev < STILL_DEV;
    Serial.printf("stillness check: swing=%.2f g (need < %.2f), |a-1|=%.2f g (need < %.2f)%s\n", swing, STILL_SWING, dev, STILL_DEV,
                  faultSinceTrigger ? "  [after an MPU fault]" : "");
    evaluateCandidate(now, stillOk);
    faultSinceTrigger = false;
  }
}

void candidateWatchdog(unsigned long now) {
  if (!watching || now - trigStart <= CANDIDATE_MAX_MS) return;
  watching = false;
  if (ALERT_ON_SENSOR_LOSS && faultSinceTrigger) sendFall("trigger, then MPU fault; stillness could not be confirmed");
  else { Serial.println("fall candidate expired -> ignored"); cooldownUntil = now + 1000; }
  faultSinceTrigger = false;
}

// loudness gate (v5) + AI cry classifier on 2 kHz bursts while loud.
void soundLogic(unsigned long now, bool linked) {
  int v = analogRead(SOUND_PIN);
  if (v < sMin) sMin = v;
  if (v > sMax) sMax = v;
  if (now - winStart < SOUND_WINDOW_MS) return;
  lastSwing = sMax - sMin;
  sMin = 4095; sMax = 0; winStart = now;
  bool loud = lastSwing > CRY_SWING;

  if (loud && !watching && now - lastBurst >= AUDIO_BURST_MS) {   // never starve a pending fall check
    lastBurst = now;
    captureBurst();
    if (now - lastCryEval >= 500) { lastCryEval = now; cryProb = classifyCry(); }
  } else if (!loud && now - lastLoud > 1600) {
    burstCount = 0; cryProb = 0;                                  // observation stale after 1.6 s of quiet
  }

  if (loud) { lastLoud = now; if (loudStart == 0) loudStart = now; }
  else if (now - lastLoud > 300) loudStart = 0;

  bool aiCry = cryProb >= AI_CRY_PROB;
  if (loudStart != 0 && now - loudStart >= CRY_MIN_MS && aiCry) {
    if (!cryActive) Serial.printf("[CRY] detected (AI cry p=%.2f)\n", cryProb);
    cryActive = true; quietSince = 0;
  } else if (loudStart == 0 || !aiCry) {
    if (!quietSince) quietSince = now;
    if (cryActive && (loudStart == 0 && now - quietSince >= CRY_QUIET_MS || !aiCry && now - quietSince >= CRY_QUIET_MS)) {
      cryActive = false; Serial.println("[CRY] ended");
    }
  }
  if (cryActive && linked && now - lastCrySend >= CRY_SEND_MS) { lastCrySend = now; sendLine("CRY\n"); }
}

void setup() {
  Serial.begin(115200); delay(500);
  Serial.println("\nBABY UNIT (BLE client, AI) START");
  Serial.println("[AI] on-device classifiers: cry (sound), fall-vs-play (accel+gyro), BLE range, fusion");
  pinMode(BTN_DEMO, INPUT_PULLUP);
  pinMode(SOUND_PIN, INPUT);
  Wire.begin(21, 22); Wire.setClock(I2C_HZ);
  if (!initMPU()) Serial.println("[ERROR] MPU6050 not found (will retry)");
  BLEDevice::init("BabyBand-ESP32");
  Serial.println("[BLE] stack started");
}

void loop() {
  unsigned long now = millis();
  bool linked = connected && rc != nullptr;
  static bool wasLinked = false;
  if (linked != wasLinked) { wasLinked = linked; Serial.println(linked ? "[LINK UP] module connected" : "[LINK DOWN]"); }

  if (!linked && now - lastAttempt >= RETRY_MS) { tryLink(); lastAttempt = millis(); return; }

  if (lineReady) { lineReady = false; Serial.print("[room unit] "); Serial.println(lastLine); }

  bool demo = digitalRead(BTN_DEMO);
  if (lastDemo == HIGH && demo == LOW) { if (linked) sendFall("BOOT button demo"); else Serial.println("[BOOT pressed but not linked]"); }
  lastDemo = demo;

  soundLogic(now, linked);
  pollRange(now, linked);

  if (!mpuAddr && now - lastMpuTry >= (watching ? 300UL : 2000UL)) { recoverMPU("MPU6050 offline, retrying"); lastMpuTry = millis(); }
  if (mpuAddr && now - lastSample >= 5) {
    lastSample = now;
    float a, gm; bool z = false;
    if (readMotion(a, gm, z)) {
      if (z) {
        zeroCount++; freefallCount = 0; lastA = 0;
        if (watching) faultSinceTrigger = true;
        if (zeroCount >= 5 && now - lastRecover > 1000) recoverMPU("all-zero sensor data (loose wire / power glitch / chip reset?)");
      } else {
        zeroCount = 0; lastA = a;
        if (linked) fallLogic(a, now); else watching = false;
      }
    } else if (now - lastRecover > 1000) recoverMPU("I2C read failed");
  }
  candidateWatchdog(now);

  // background activity recognition for the USB status line (no alerts)
  if (mpuAddr && !watching && ringFill >= MOTION_N && now - lastClassify >= 1000) {
    lastClassify = now;
    float probs[3];
    lastMotionClass = classifyMotion(probs);
    lastMotionProbs[0] = probs[0]; lastMotionProbs[1] = probs[1]; lastMotionProbs[2] = probs[2];
  }

  if (mpuAddr && now - lastMpuCheck >= 500) {
    lastMpuCheck = now;
    uint8_t pm = 0;
    if (!mpuRegRead(mpuAddr, 0x6B, pm)) { if (now - lastRecover > 1000) recoverMPU("PWR_MGMT_1 read failed"); }
    else if (pm & 0x40) recoverMPU("MPU6050 is in sleep mode (it was reset)");
  }

  if (linked && now - lastBeat >= HEARTBEAT_MS) { lastBeat = now; sendLine("OK\n"); }

  if (now - lastStatus >= 2000) {
    lastStatus = now;
    const char *act = lastMotionClass == 2 ? "FALL?" : lastMotionClass == 1 ? "active/play" : "normal";
    Serial.printf("status | link=%s mpu=%s |a|=%.2f g peak=%.2f g i2cFaults=%d rxBytes=%lu | swing=%d cryAI=%.2f cry=%d | act=%s (p %.2f/%.2f/%.2f) | rssi=%.0f zone=%s wander=%d\n",
                  linked ? "UP" : "DOWN", mpuAddr ? (zeroCount ? "ZERO-DATA" : "ok") : "offline", lastA, peakG, i2cFaults, (unsigned long)rxBytes,
                  lastSwing, cryProb, (int)cryActive, act, lastMotionProbs[0], lastMotionProbs[1], lastMotionProbs[2],
                  rssiInit ? rssiEma : 0.0, zoneName(rangeZone), (int)wandering);
    peakG = 0;
  }
}
